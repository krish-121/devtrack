# Copy this file to .env in the repository root before starting the API/database.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Exact browser origin, without a trailing slash. HTTPS is required in production.
APP_ORIGIN=http://localhost:5173
# Combined registration/login requests per IP per 15-minute window.
AUTH_RATE_LIMIT_MAX=20

# Local development examples only; never use these credentials in production.
# Keep POSTGRES_PASSWORD and the password in DATABASE_URL in sync.
POSTGRES_PASSWORD=devtrack_local
DATABASE_URL=postgresql://devtrack:devtrack_local@localhost:5432/devtrack_dev
